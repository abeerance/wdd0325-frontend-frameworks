# Dockerfile.production
#
# Three stages. `vendor` installs the PHP packages, `app` is php-fpm with the code baked in,
# `web` is nginx with the public folder. compose.production.yaml builds `app` and `web`;
# `vendor` exists only to feed them, and Composer never reaches a running container.

FROM composer:2.10.3 AS vendor

WORKDIR /app

# The packages first, on a layer of their own, so editing a controller does not download them again.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-autoloader --no-scripts --no-interaction --prefer-dist

# Then the code, and one class map naming every class in it and in the packages. It has to
# come after the code: a class map written before app/ exists would not list the app's classes.
COPY . .
RUN composer dump-autoload --no-dev --optimize --no-scripts --no-interaction


FROM php:8.5.10-fpm-alpine AS app

# pdo_pgsql needs libpq to run and the PostgreSQL headers only to build. The headers go again
# once it is built, so the image carries what runs and nothing that only compiled it.
RUN apk add --no-cache libpq \
 && apk add --no-cache --virtual .build-deps postgresql-dev \
 && docker-php-ext-install pdo_pgsql \
 && apk del .build-deps

# PHP's recommended production settings, then this project's on top.
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY php.production.ini "$PHP_INI_DIR/conf.d/zz-production.ini"

WORKDIR /var/www/html

COPY --from=vendor /app ./

# Which service providers the packages bring depends on vendor/ alone, so the list is written
# once, here. Then the only two folders the application writes to become www-data's, the
# account php-fpm runs as; every other file stays root's, readable and not writable.
RUN php artisan package:discover \
 && chown -R www-data:www-data storage bootstrap/cache

USER www-data

# Settings arrive with the container, so the caches built from them are built when it starts,
# before php-fpm takes its first request. A container is never left serving stale caches.
# An API renders no Blade views and has no resources/views folder, so there is nothing for
# the views step to compile; asked to, it fails and the container would never start.
CMD ["sh", "-c", "php artisan optimize --except=views && exec php-fpm"]


# nginx's own unprivileged build: the same nginx, run as the `nginx` account and listening
# on 8080, so no process in this stack runs as root.
FROM nginxinc/nginx-unprivileged:1.30.5-alpine AS web

COPY nginx.production.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public
