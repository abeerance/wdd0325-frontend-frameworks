<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- The tests run on SQLite in memory, the engine students use. The Docker and production
             setup runs PostgreSQL: run the suite against it with DB_CONNECTION=pgsql in the shell
             (a variable already set there wins over these defaults). -->
        <!-- serve.sh keeps the app key out of .env, so the tests bring a throwaway one of their own. -->
        <env name="APP_KEY" value="base64:x1Ba6BANWDWrfeYTbO1iRdS8mPQsrNSOX1dB8DIt4Hs="/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost"/>
    </php>
</phpunit>
