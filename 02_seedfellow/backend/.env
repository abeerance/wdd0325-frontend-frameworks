# Classroom-only local configuration. Generate your own APP_KEY during first setup.
APP_NAME=Seedfellow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=seedfellow
DB_USERNAME=seedfellow
DB_PASSWORD=seedfellow-classroom

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_COOKIE=seedfellow-session

SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000
FRONTEND_URL=http://localhost:3000

CACHE_STORE=database
FILESYSTEM_DISK=local
