meta {
  name: Log in with the wrong password
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/login
  body: json
}

headers {
  Accept: application/json
  Origin: {{origin}}
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "email": "tomas@example.org",
    "password": "not the password"
  }
}

assert {
  res.status: eq 422
  res.body.message: eq Those details did not match.
  res.body.errors.email[0]: eq Those details did not match.
}
