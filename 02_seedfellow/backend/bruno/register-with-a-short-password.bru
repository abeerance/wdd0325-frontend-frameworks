meta {
  name: Register with a short password
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/register
  body: json
}

headers {
  Accept: application/json
  Origin: {{origin}}
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "name": "Ana Keller",
    "email": "ana@example.org",
    "password": "beans",
    "password_confirmation": "beans"
  }
}

assert {
  res.status: eq 422
  res.body.errors.password[0]: eq The password field must be at least 12 characters.
}
