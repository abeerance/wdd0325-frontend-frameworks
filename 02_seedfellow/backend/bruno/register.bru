meta {
  name: Register
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/register
  body: json
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Ana Keller",
    "email": "ana@example.org",
    "password": "a row of runner beans",
    "password_confirmation": "a row of runner beans",
    "is_librarian": true
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

assert {
  res.status: eq 201
  res.body.token: isString
  res.body.member.id: eq 3
  res.body.member.name: eq Ana Keller
  res.body.member.email: eq ana@example.org
  res.body.member.is_librarian: eq false
  res.body.member.password: isUndefined
}
