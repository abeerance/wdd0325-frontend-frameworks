meta {
  name: Write a harvest note
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/api/borrowings/{{borrowingId}}/harvest-note
  body: json
}

headers {
  Accept: application/json
  Origin: {{origin}}
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "body": "Sown in a trough on the balcony, netted against the pigeons. Eleven plants, pods from July.",
    "seeds_sown": 16,
    "seeds_germinated": 11
  }
}

script:post-response {
  bru.setVar("harvestNoteId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.seeds_germinated: eq 11
  res.body.data.has_photo: eq false
  res.body.data.grown_by: eq Tomas Rieder
}
