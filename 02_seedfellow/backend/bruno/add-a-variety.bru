meta {
  name: Add a variety
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/api/varieties
  body: json
}

headers {
  Accept: application/json
  Origin: {{origin}}
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "name": "Zollinger Buschbohne",
    "species": "Phaseolus vulgaris",
    "kind": "vegetable",
    "story": "A bush bean kept in the Valais, brought in by a member who grew it on an allotment for thirty years.",
    "sowing_months": [5, 6]
  }
}

script:post-response {
  bru.setVar("varietyId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.packets_available: eq 0
  res.body.data.retired: eq false
}
