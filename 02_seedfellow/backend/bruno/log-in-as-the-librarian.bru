meta {
  name: Log in as the librarian
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/api/login
  body: json
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "marit@example.org",
    "password": "seeds-in-the-post"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

assert {
  res.status: eq 200
  res.body.token: isString
  res.body.member.is_librarian: eq true
}
