meta {
  name: List varieties
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/varieties
}

headers {
  Accept: application/json
  Origin: {{origin}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 28
  res.body.meta.per_page: eq 15
  res.body.data[0].name: eq Berner Rose
  res.body.data[0].packets_available: eq 4
  res.body.data[0].photo_version: eq f2911967724b6584
  res.body.data[0].photo_credit.licence: eq CC BY-SA 4.0
  res.body.data[0].photo_credit.modified: eq true
}
