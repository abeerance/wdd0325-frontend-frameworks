meta {
  name: Register with an unconfirmed password
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/register
  body: json
}

headers {
  Accept: application/json
  Origin: {{origin}}
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "name": "Ana Keller",
    "email": "ana@example.org",
    "password": "a row of runner beans",
    "password_confirmation": "a row of broad beans"
  }
}

assert {
  res.status: eq 422
  res.body.errors.password[0]: eq The password field confirmation does not match.
}
