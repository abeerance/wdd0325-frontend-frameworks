meta {
  name: Log in
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/login
  body: json
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "tomas@example.org",
    "password": "correct horse battery staple"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

assert {
  res.status: eq 200
  res.body.token: isString
  res.body.member.id: eq 2
  res.body.member.name: eq Tomas Rieder
  res.body.member.is_librarian: eq false
  res.body.member.created_at: eq 2026-01-19T09:00:00.000000Z
}
