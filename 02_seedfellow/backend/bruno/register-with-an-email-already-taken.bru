meta {
  name: Register with an email already taken
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/register
  body: json
}

headers {
  Accept: application/json
  Origin: {{origin}}
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "name": "Ana Keller",
    "email": "Tomas@Example.org",
    "password": "a row of runner beans",
    "password_confirmation": "a row of runner beans"
  }
}

assert {
  res.status: eq 422
  res.body.message: eq That email already belongs to a member. Log in instead.
  res.body.errors.email[0]: eq That email already belongs to a member. Log in instead.
}
