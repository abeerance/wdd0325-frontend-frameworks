meta {
  name: Correct the harvest note
  type: http
  seq: 30
}

patch {
  url: {{baseUrl}}/api/harvest-notes/{{harvestNoteId}}
  body: json
}

headers {
  Accept: application/json
  Origin: {{origin}}
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "seeds_germinated": 12
  }
}

assert {
  res.status: eq 200
  res.body.data.seeds_germinated: eq 12
  res.body.data.seeds_sown: eq 16
}
