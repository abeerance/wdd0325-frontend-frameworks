meta {
  name: Upload a harvest photo
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/harvest-notes/{{harvestNoteId}}/photo
  body: multipartForm
}

headers {
  Accept: application/json
  Origin: {{origin}}
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:multipart-form {
  photo: @file(seed-photo.png)
}

assert {
  res.status: eq 201
  res.body.data.id: eq {{harvestNoteId}}
  res.body.data.has_photo: eq true
  res.body.data.photo_path: isUndefined
  res.body.data.photo_version: eq b5d0c95ec1c64536
}
