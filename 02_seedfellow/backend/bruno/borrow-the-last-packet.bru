meta {
  name: Borrow the last packet of a variety
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/borrowings
  body: json
}

headers {
  Accept: application/json
  Origin: {{origin}}
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "variety_id": 9
  }
}

script:post-response {
  bru.setVar("borrowingId", res.body.data.id);
}

assert {
  res.status: eq 201
  res.body.data.variety.name: eq Verte de Cambrai
  res.body.data.returned_on: isNull
  res.body.data.harvest_note: isNull
}
